{
  "name": "automated-smoke-test",
  "version": "1.0.0",
  "description": "Community App Automation Tests",
  "private": true,
  "main": "conf.js",
  "engines": {
    "node": "^24.18.0",
    "npm": "^11.16.0"
  },
  "dependencies": {
    "jasmine-reporters": "^2.5.2",
    "lodash": "^4.18.1",
    "protractor": "7.0.0",
    "protractor-beautiful-reporter": "^1.3.6",
    "topcoder-testing-lib": "git+https://github.com/topcoder-platform/topcoder-testing-lib.git#a5a1ebf0b5fce818fc38339af4d0106fe5a79974",
    "webdriver-manager": "^12.1.9",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/jasmine": "^5.1.15",
    "@types/jasminewd2": "^2.0.13",
    "@types/lodash": "^4.17.24",
    "@types/node": "^24.13.3",
    "rimraf": "^6.1.3",
    "tslint": "^6.1.3",
    "tslint-config-prettier": "^1.18.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@types/node": "$@types/node",
    "@xmldom/xmldom": "0.9.10",
    "adm-zip": "0.6.0",
    "brace-expansion": "5.0.9",
    "del": "6.1.1",
    "glob": "13.0.6",
    "globby": "11.1.0",
    "jsdom": "30.0.1",
    "minimatch": "10.2.6",
    "protractor": "$protractor",
    "request": "npm:@cypress/request@4.0.1",
    "tmp": "0.2.7",
    "typescript": "$typescript",
    "winston": "$winston",
    "xml2js": "0.6.2",
    "xmldom": "npm:@xmldom/xmldom@0.9.10"
  },
  "scripts": {
    "tsc": "tsc",
    "clean": "rimraf temp/ && rimraf download/ && rimraf test-results/",
    "build": "npm run clean && npm run tsc",
    "webdriver-update": "node node_modules/protractor/bin/webdriver-manager update",
    "pretest": "npm run webdriver-update && npm run clean && npm run tsc",
    "test": "protractor temp/conf.js",
    "local-test": "cp config/automation-config-local.json config/config.json && protractor temp/conf.js"
  },
  "keywords": [
    "protractor",
    "jasmine",
    "typescript"
  ]
}
