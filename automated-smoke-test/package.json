{
  "name": "automated-smoke-test",
  "version": "1.0.0",
  "description": "Community App Automation Tests",
  "main": "conf.js",
  "dependencies": {
    "@types/node": "24.19.2",
    "jasmine": "3.99.0",
    "jasmine-reporters": "2.5.2",
    "lodash": "4.18.1",
    "protractor": "5.4.4",
    "protractor-beautiful-reporter": "1.3.6",
    "topcoder-testing-lib": "git+ssh://git@github.com/topcoder-platform/topcoder-testing-lib.git#a5a1ebf0b5fce818fc38339af4d0106fe5a79974",
    "tslint-config-prettier": "^1.18.0",
    "typescript": "5.9.3",
    "webdriver-manager": "12.1.9",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@types/jasmine": "3.10.19",
    "@types/jasminewd2": "2.0.13",
    "@types/lodash": "4.17.27",
    "rimraf": "6.1.3",
    "tslint": "6.1.3"
  },
  "scripts": {
    "tsc": "tsc",
    "clean": "rimraf temp/ && rimraf download/ && rimraf test-results/",
    "webdriver-update": "node node_modules/protractor/bin/webdriver-manager update",
    "pretest": "npm run webdriver-update && npm run clean && npm run tsc",
    "test": "protractor temp/conf.js",
    "local-test": "cp config/automation-config-local.json config/config.json && protractor temp/conf.js"
  },
  "keywords": [
    "protractor",
    "jasmine",
    "typescript"
  ],
  "overrides": {
    "lodash": "$lodash",
    "typescript": "$typescript",
    "protractor": "$protractor",
    "winston": "$winston",
    "jsdom": "27.4.0",
    "request": "npm:@cypress/request@4.0.1",
    "xml2js": "0.6.2",
    "minimatch@<9": "file:tools/minimatch-compat",
    "minimatch@>=9": "11.0.3",
    "qs": "6.17.1",
    "form-data": "4.0.6",
    "uuid": "11.1.1",
    "underscore": "1.13.8",
    "ini": "1.3.8",
    "yauzl": "3.2.1",
    "brace-expansion@<2": "1.1.21",
    "brace-expansion@>=2 <3": "2.1.7",
    "http-proxy-agent": "7.0.2",
    "https-proxy-agent": "7.0.6",
    "adm-zip": "0.6.1",
    "ansi-regex@^3": "3.0.1",
    "glob@>=9": "14.0.3",
    "js-yaml@<4": "3.15.2",
    "jszip": "3.10.1",
    "minimist": "1.2.8",
    "path-parse": "1.0.7",
    "semver@<6": "5.7.2",
    "tmp": "0.2.7",
    "y18n@^4": "4.0.3",
    "yargs-parser@<14": "13.1.2",
    "cross-spawn": "7.0.6"
  }
}
